 &EMsampler
! point group number
!   #1:    '1', #2:    '-1', #3:      '2', #4:    'm', #5:  '2/m', #6:   '222', #7:    'mm2', #8:   'mmm'
!   #9:    '4', #10:   '-4', #11:   '4/m', #12: '422', #13: '4mm', #14: '-42m', #15: '4/mmm', #16:    '3'
!   #17:  '-3', #18:   '32', #19:    '3m', #20: '-3m', #21:   '6', #22:   '-6', #23:   '6/m', #24:  '622'
!   #25: '6mm', #26: '-6m2', #27: '6/mmm', #28:  '23', #29:  'm3', #30:  '432', #31:  '-43m', #32: 'm-3m'
! additional point groups (note that not all EMsoftOO functionality may be available for these groups)
!   #33: '532', #34: ' 822', #35:  '1022', #36:'1222', #37: '312', #38:  '31m', #39:  '-31m', #40: '-4m2'
!   #41:'-62m'
 pgnum = 32,
! relative path to output file [relative to EMdatapathname]
 hdfname = 'undefined',
! image folder path
 imagefolder = 'undefined',
! image prefix (will be .png file)
 prefix = 'undefined',
! PoVray executable location
 PVexec = 'undefined',
! location of PoVray indluce files
 PVincludepath = 'undefined'
! number of orientations to sample
 norientations = 5000,
! seeds for random number generator; seed1 for sampling, seed2 for averaging
 seed1 = 4533321,
 seed2 = 7642029,
! viewangle (degrees): 0.D0 means that the observer point lies along the x-axis, a bit above the horizontal plane
 viewangle = 0.D0,
! concentration parameters (2, double precision)
 kappa = 512.D0, 3456.D0,
! 4 mean directions (3-component Rodrigues vectors)
 dir1 = 0.D0, 0.D0, 0.D0,
 dir2 = 0.D0, 0.D0, 0.D0,
 dir3 = 0.D0, 0.D0, 0.D0,
 dir4 = 0.D0, 0.D0, 0.D0,
 /
